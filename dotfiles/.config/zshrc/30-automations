# -----------------------------------------------------
# AUTOSTART
# -----------------------------------------------------

# Skip banner/fetch when shell is not an interactive human session
# (Claude Code, scripts, pipes, NO_FETCH=1 → silencia tudo)
if [[ -o interactive && -t 1 && -z "$CLAUDECODE" && -z "$NO_FETCH" ]]; then
    # -----------------------------------------------------
    # Pywal
    # -----------------------------------------------------
    cat ~/.cache/wal/sequences

    # -----------------------------------------------------
    # Spacefetch (animado enquanto se digita); ghosttyfetch se ele faltar
    # -----------------------------------------------------
    if [[ $(tty) == *"pts"* ]]; then
        if [[ -f "$HOME/programing/personal/spacefetch/spacefetch.zsh" ]]; then
            source "$HOME/programing/personal/spacefetch/spacefetch.zsh"
            spacefetch_start
        else
            "$HOME/.local/bin/ghosttyfetch" < /dev/null
        fi
    else
        echo
        if [ -f /bin/qtile ]; then
            echo "Start Qtile X11 with command Qtile"
        fi
        if [ -f /bin/hyprctl ]; then
            echo "Start Hyprland with command Hyprland"
        fi
    fi
fi

# -----------------------------------------------------
# Agente SSH das VMs do Prisma
# -----------------------------------------------------
# O ~/.ssh/config aponta IdentityAgent para este socket fixo, entao o agente
# precisa existir antes de qualquer ssh vm-*. Aqui so o processo e garantido;
# a chave continua sendo carregada a mao, com "ssh-add", uma vez por boot.
if [ ! -S "$HOME/.ssh/agent.sock" ]; then
    ssh-agent -a "$HOME/.ssh/agent.sock" > /dev/null 2>&1
fi
export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
