# -----------------------------------------------------
# RDP (xfreerdp3)
# -----------------------------------------------------
# As credenciais ficam em ~/.config/rdp/credentials (chmod 600), fora daqui.
# A linha de comando inteira vai por stdin (/args-from:stdin), entao a senha
# nao aparece em `ps`, nem no historico, nem neste arquivo.
#
# Diagnostico de clipboard: rdp <host> /drive:tools,$HOME/.config/rdp/tools
# e no Windows: powershell -ExecutionPolicy Bypass -File \\tsclient\tools\clipdump.ps1 <rotulo>
rdp() {
  local cfg="${RDP_CREDENTIALS:-$HOME/.config/rdp/credentials}"
  [[ -r $cfg ]] || { print -u2 "rdp: credenciais nao encontradas em $cfg"; return 1 }

  local -A RDP_HOSTS RDP_DESC
  source "$cfg"

  local alvo=$1
  if [[ -z $alvo || -z ${RDP_HOSTS[$alvo]} ]]; then
    print -u2 "uso: rdp <host> [opcoes extras do xfreerdp3]"
    print -u2 "hosts:"
    local h
    for h in ${(ko)RDP_HOSTS}; do
      printf '  %-12s %-11s %s\n' "$h" "${RDP_HOSTS[$h]%%|*}" "${RDP_DESC[$h]}" >&2
    done
    return 1
  fi
  shift

  local ip user pass
  IFS='|' read -r ip user pass <<< "${RDP_HOSTS[$alvo]}"

  printf '%s\n' "/u:$user" "/p:$pass" "/v:$ip" \
                "/size:${RDP_SIZE:-1920x1080}" /cert:ignore "$@" \
    | ${RDP_BIN:-xfreerdp3} /args-from:stdin
}

alias rdp-ponto='rdp ponto'
