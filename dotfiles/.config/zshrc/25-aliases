# -----------------------------------------------------
# Wallpaper
# -----------------------------------------------------
# Referencia de cor do tema (pywal), independente do wallpaper na tela.
#   wallcolor <imagem>   fixa a imagem como fonte das cores
#   wallcolor --auto     volta a derivar do wallpaper atual
#   wallcolor            mostra a referencia em uso
alias wallcolor='~/.config/hypr/scripts/wallpaper-colors.sh'

# Troca o wallpaper de UM monitor. Sempre com --monitor: sem ele o waypaper
# colapsa a config por monitor num unico par "All" e voce perde o pareamento.
#   wallset DP-1 ~/Wallpaper/live/algum.mp4
wallset() {
  if [[ -z ${1:-} || -z ${2:-} ]]; then
    print -u2 "uso: wallset <monitor> <arquivo>"
    print -u2 "monitores:"
    hyprctl monitors -j | python3 -c '
import json, sys
for m in json.load(sys.stdin):
    print("  %-12s %sx%s" % (m["name"], m["width"], m["height"]))' >&2
    return 1
  fi
  waypaper --wallpaper "$2" --monitor "$1"
}
