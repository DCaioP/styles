# Motivation
# -----------------------------------------------------

# \033[1;33m = Amarelo Negrito
# \033[0m    = Reseta a cor

if [[ -o interactive && -t 1 && -z "$CLAUDECODE" && -z "$NO_FETCH" ]]; then
    echo -e "\n\033[1;33m"
    echo "╔═══════════════════════════════════════════╗"
    echo "║     Você ainda não fez algo incrível!     ║"
    echo "╚═══════════════════════════════════════════╝"
    echo -e "\033[0m\n"
fi
